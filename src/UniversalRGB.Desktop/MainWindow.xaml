<Window x:Class="UniversalRGB.Desktop.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Universal RGB Control" Width="1320" Height="860" MinWidth="1040" MinHeight="660"
        WindowStartupLocation="CenterScreen" Icon="pack://application:,,,/Assets/app.ico"
        Background="{StaticResource Bg}" Foreground="{StaticResource Text}"
        FontFamily="{StaticResource UiFont}" FontSize="13.5"
        UseLayoutRounding="True" TextOptions.TextFormattingMode="Display">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="244"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- ============================ Sidebar -->
        <Border Background="{StaticResource Bg2}" BorderBrush="{StaticResource Line}" BorderThickness="0,0,1,0">
            <DockPanel Margin="14,20,14,16">
                <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="8,0,0,26">
                    <Grid Width="32" Height="32">
                        <Border CornerRadius="9" Background="{StaticResource Panel2}" BorderBrush="{StaticResource Line}" BorderThickness="1"/>
                        <Ellipse Width="18" Height="18" StrokeThickness="3.5" Stroke="{StaticResource RgbGradient}"/>
                    </Grid>
                    <StackPanel Margin="11,0,0,0" VerticalAlignment="Center">
                        <TextBlock Text="Universal RGB" FontWeight="SemiBold" FontSize="14.5"/>
                        <TextBlock Text="{Binding Version}" Style="{StaticResource TextDim}" FontSize="11.5"/>
                    </StackPanel>
                </StackPanel>

                <!-- Backend status -->
                <Border DockPanel.Dock="Bottom" Style="{StaticResource SubCard}" Padding="14,12">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal">
                            <Ellipse Width="8" Height="8" VerticalAlignment="Center" Fill="{Binding Center.IsConnected, Converter={StaticResource StatusBrush}}"/>
                            <TextBlock Text="{Binding Center.ConnectionText}" Margin="8,0,0,0" FontWeight="SemiBold" FontSize="12.5"/>
                        </StackPanel>
                        <TextBlock Text="{Binding Center.ConnectionDetail}" Style="{StaticResource TextDim}" FontSize="11.5" Margin="0,6,0,0"
                                   MaxHeight="46" TextTrimming="CharacterEllipsis" ToolTip="{Binding Center.ConnectionDetail}"/>
                        <Grid Margin="0,12,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <Button Command="{Binding ConnectCommand}" Height="32" FontSize="12.5">
                                <Button.Style>
                                    <Style TargetType="Button" BasedOn="{StaticResource BtnBase}">
                                        <Setter Property="Content" Value="Connect"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding Center.IsConnected}" Value="True">
                                                <Setter Property="Content" Value="Disconnect"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Button.Style>
                            </Button>
                            <Button Grid.Column="1" Margin="6,0,0,0" Width="32" Height="32" Padding="0" Command="{Binding TogglePauseCommand}"
                                    FontFamily="{StaticResource IconFont}" FontWeight="Normal">
                                <Button.Style>
                                    <Style TargetType="Button" BasedOn="{StaticResource BtnBase}">
                                        <Setter Property="Content" Value="&#xE769;"/>
                                        <Setter Property="ToolTip" Value="Pause the lighting engine (devices keep their colors)"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding Center.LightingPaused}" Value="True">
                                                <Setter Property="Content" Value="&#xE768;"/>
                                                <Setter Property="ToolTip" Value="Resume the lighting engine"/>
                                                <Setter Property="Foreground" Value="{StaticResource Amber}"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Button.Style>
                            </Button>
                        </Grid>
                    </StackPanel>
                </Border>

                <StackPanel>
                    <TextBlock Text="MENU" Style="{StaticResource Caption}" Margin="12,0,0,10"/>
                    <RadioButton GroupName="nav" Style="{StaticResource NavButton}" Tag="&#xE80F;" Content="Dashboard"
                                 Command="{Binding NavigateCommand}" CommandParameter="dashboard"
                                 IsChecked="{Binding CurrentKey, Mode=OneWay, Converter={StaticResource Eq}, ConverterParameter=dashboard}"/>
                    <RadioButton GroupName="nav" Style="{StaticResource NavButton}" Tag="&#xE772;" Content="Devices"
                                 Command="{Binding NavigateCommand}" CommandParameter="devices"
                                 IsChecked="{Binding CurrentKey, Mode=OneWay, Converter={StaticResource Eq}, ConverterParameter=devices}"/>
                    <RadioButton GroupName="nav" Style="{StaticResource NavButton}" Tag="&#xE790;" Content="Lighting Studio"
                                 Command="{Binding NavigateCommand}" CommandParameter="lighting"
                                 IsChecked="{Binding CurrentKey, Mode=OneWay, Converter={StaticResource Eq}, ConverterParameter=lighting}"/>
                    <RadioButton GroupName="nav" Style="{StaticResource NavButton}" Tag="&#xE8F1;" Content="Profiles"
                                 Command="{Binding NavigateCommand}" CommandParameter="profiles"
                                 IsChecked="{Binding CurrentKey, Mode=OneWay, Converter={StaticResource Eq}, ConverterParameter=profiles}"/>
                    <RadioButton GroupName="nav" Style="{StaticResource NavButton}" Tag="&#xE90F;" Content="Drivers"
                                 Command="{Binding NavigateCommand}" CommandParameter="drivers"
                                 IsChecked="{Binding CurrentKey, Mode=OneWay, Converter={StaticResource Eq}, ConverterParameter=drivers}"/>
                    <RadioButton GroupName="nav" Style="{StaticResource NavButton}" Tag="&#xE713;" Content="Settings"
                                 Command="{Binding NavigateCommand}" CommandParameter="settings"
                                 IsChecked="{Binding CurrentKey, Mode=OneWay, Converter={StaticResource Eq}, ConverterParameter=settings}"/>

                    <Border Margin="4,22,4,0" Height="2" CornerRadius="1" Background="{StaticResource RgbGradient}" Opacity="0.85"/>
                    <TextBlock Margin="12,12,8,0" Style="{StaticResource TextDim}" FontSize="11.5"
                               Text="Lighting only. Fan and pump speeds are never changed."/>
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- ============================ Content -->
        <Grid Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <ProgressBar IsIndeterminate="True" VerticalAlignment="Top" Grid.RowSpan="2" Panel.ZIndex="5"
                         Visibility="{Binding Center.IsBusy, Converter={StaticResource BoolToVis}}"/>

            <Grid Margin="36,30,36,18">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock Text="{Binding PageTitle}" Style="{StaticResource H1}"/>
                    <TextBlock Text="{Binding PageSubtitle}" Style="{StaticResource TextMuted}" FontSize="13.5" Margin="0,4,0,0"/>
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="{Binding Center.BusyText}" Style="{StaticResource TextMuted}" VerticalAlignment="Center" Margin="0,0,14,0"/>
                    <Border Background="{StaticResource Panel2}" BorderBrush="{StaticResource Line}" BorderThickness="1" CornerRadius="999" Padding="12,6">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE945;" Style="{StaticResource Icon}" FontSize="12" Foreground="{StaticResource Accent}"/>
                            <TextBlock Text="Running:" Style="{StaticResource TextDim}" Margin="8,0,4,0" VerticalAlignment="Center"/>
                            <TextBlock Text="{Binding Center.LiveDescription}" FontSize="12.5" FontWeight="SemiBold" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Grid>

            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Focusable="False">
                <ContentControl Content="{Binding CurrentPage}" Margin="36,0,36,40" Focusable="False"/>
            </ScrollViewer>

            <!-- Toast -->
            <Border Grid.Row="1" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,28,24" MaxWidth="460"
                    Background="{StaticResource Panel3}" BorderThickness="1" CornerRadius="12" Padding="14,11"
                    Visibility="{Binding Toast, Converter={StaticResource NullToVis}}">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="20" ShadowDepth="0" Opacity="0.55"/>
                </Border.Effect>
                <Border.Style>
                    <Style TargetType="Border">
                        <Setter Property="BorderBrush" Value="{StaticResource Line2}"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding Toast.Kind}" Value="Success">
                                <Setter Property="BorderBrush" Value="#5534D399"/>
                            </DataTrigger>
                            <DataTrigger Binding="{Binding Toast.Kind}" Value="Warning">
                                <Setter Property="BorderBrush" Value="#55FBBF24"/>
                            </DataTrigger>
                            <DataTrigger Binding="{Binding Toast.Kind}" Value="Error">
                                <Setter Property="BorderBrush" Value="#66F87171"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock VerticalAlignment="Top" Margin="0,1,12,0" FontSize="15">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock" BasedOn="{StaticResource Icon}">
                                <Setter Property="Text" Value="&#xE946;"/>
                                <Setter Property="Foreground" Value="{StaticResource Accent}"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Toast.Kind}" Value="Success">
                                        <Setter Property="Text" Value="&#xE73E;"/>
                                        <Setter Property="Foreground" Value="{StaticResource Green}"/>
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding Toast.Kind}" Value="Warning">
                                        <Setter Property="Text" Value="&#xE7BA;"/>
                                        <Setter Property="Foreground" Value="{StaticResource Amber}"/>
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding Toast.Kind}" Value="Error">
                                        <Setter Property="Text" Value="&#xE783;"/>
                                        <Setter Property="Foreground" Value="{StaticResource Red}"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                    <TextBlock Grid.Column="1" Text="{Binding Toast.Text}" Style="{StaticResource Body}" FontSize="13"/>
                    <Button Grid.Column="2" Style="{StaticResource IconButton}" Content="&#xE711;" FontSize="10" Width="24" Height="24"
                            Margin="10,-3,-6,0" VerticalAlignment="Top" Command="{Binding DismissToastCommand}" ToolTip="Dismiss"/>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</Window>
