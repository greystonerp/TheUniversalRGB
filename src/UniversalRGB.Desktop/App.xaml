<Application x:Class="UniversalRGB.Desktop.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="clr-namespace:UniversalRGB.Desktop.Converters"
             xmlns:vm="clr-namespace:UniversalRGB.Desktop.ViewModels"
             xmlns:v="clr-namespace:UniversalRGB.Desktop.Views"
             ShutdownMode="OnExplicitShutdown">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Themes/Theme.xaml"/>
            </ResourceDictionary.MergedDictionaries>

            <c:BoolToVisibilityConverter x:Key="BoolToVis"/>
            <c:NullToVisibilityConverter x:Key="NullToVis"/>
            <c:InverseBoolConverter x:Key="Not"/>
            <c:ColorToBrushConverter x:Key="ColorBrush"/>
            <c:StatusBrushConverter x:Key="StatusBrush"/>
            <c:StatusTextConverter x:Key="StatusText"/>
            <c:EqualityConverter x:Key="Eq"/>
            <c:EqualsVisibilityConverter x:Key="EqVis"/>

            <DataTemplate DataType="{x:Type vm:DashboardViewModel}">
                <v:DashboardView/>
            </DataTemplate>
            <DataTemplate DataType="{x:Type vm:DevicesViewModel}">
                <v:DevicesView/>
            </DataTemplate>
            <DataTemplate DataType="{x:Type vm:LightingViewModel}">
                <v:LightingView/>
            </DataTemplate>
            <DataTemplate DataType="{x:Type vm:ProfilesViewModel}">
                <v:ProfilesView/>
            </DataTemplate>
            <DataTemplate DataType="{x:Type vm:DriversViewModel}">
                <v:DriversView/>
            </DataTemplate>
            <DataTemplate DataType="{x:Type vm:SettingsViewModel}">
                <v:SettingsView/>
            </DataTemplate>

            <!-- Status badge used across pages: DataContext is a DeviceStatus or RequirementState. -->
            <DataTemplate x:Key="StatusBadge">
                <Border Style="{StaticResource Badge}" Background="{Binding Converter={StaticResource StatusBrush}, ConverterParameter=soft}"
                        BorderBrush="{Binding Converter={StaticResource StatusBrush}}">
                    <StackPanel Orientation="Horizontal">
                        <Ellipse Width="6" Height="6" Fill="{Binding Converter={StaticResource StatusBrush}}" VerticalAlignment="Center"/>
                        <TextBlock Text="{Binding Converter={StaticResource StatusText}}" Foreground="{Binding Converter={StaticResource StatusBrush}}"
                                   FontSize="11.5" FontWeight="SemiBold" Margin="6,0,0,0"/>
                    </StackPanel>
                </Border>
            </DataTemplate>
        </ResourceDictionary>
    </Application.Resources>
</Application>
