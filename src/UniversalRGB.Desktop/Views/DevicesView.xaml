<UserControl x:Class="UniversalRGB.Desktop.Views.DevicesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <StackPanel>
        <Grid>
            <StackPanel Orientation="Horizontal">
                <RadioButton GroupName="devfilter" Style="{StaticResource ChipToggle}" Margin="0,0,8,0"
                             IsChecked="{Binding Filter, Converter={StaticResource Eq}, ConverterParameter=all}">
                    <TextBlock><Run Text="All"/> <Run Text="{Binding AllCount, Mode=OneWay}" Foreground="{StaticResource Dim}"/></TextBlock>
                </RadioButton>
                <RadioButton GroupName="devfilter" Style="{StaticResource ChipToggle}" Margin="0,0,8,0"
                             IsChecked="{Binding Filter, Converter={StaticResource Eq}, ConverterParameter=controllable}">
                    <TextBlock><Run Text="Controllable"/> <Run Text="{Binding ControllableCount, Mode=OneWay}" Foreground="{StaticResource Dim}"/></TextBlock>
                </RadioButton>
                <RadioButton GroupName="devfilter" Style="{StaticResource ChipToggle}" Margin="0,0,8,0"
                             IsChecked="{Binding Filter, Converter={StaticResource Eq}, ConverterParameter=attention}">
                    <TextBlock><Run Text="Needs attention"/> <Run Text="{Binding AttentionCount, Mode=OneWay}" Foreground="{StaticResource Dim}"/></TextBlock>
                </RadioButton>
                <RadioButton GroupName="devfilter" Style="{StaticResource ChipToggle}"
                             IsChecked="{Binding Filter, Converter={StaticResource Eq}, ConverterParameter=offline}">
                    <TextBlock><Run Text="Offline"/> <Run Text="{Binding OfflineCount, Mode=OneWay}" Foreground="{StaticResource Dim}"/></TextBlock>
                </RadioButton>
            </StackPanel>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Command="{Binding RescanCommand}" Margin="0,0,8,0">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE72C;" Style="{StaticResource Icon}" FontSize="13" Margin="0,0,8,0"/>
                        <TextBlock Text="Rescan"/>
                    </StackPanel>
                </Button>
                <Button Content="Device Manager" Style="{StaticResource GhostButton}" Command="{Binding OpenDeviceManagerCommand}"/>
            </StackPanel>
        </Grid>

        <Grid Margin="0,18,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1.05*"/>
                <ColumnDefinition Width="20"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- List -->
            <StackPanel>
                <Border Style="{StaticResource Card}" Padding="22"
                        Visibility="{Binding Items.Count, Converter={StaticResource EqVis}, ConverterParameter=0}">
                    <StackPanel>
                        <TextBlock Text="Nothing to show" Style="{StaticResource H3}"/>
                        <TextBlock Style="{StaticResource TextMuted}" Margin="0,4,0,0"
                                   Text="No devices match this filter. Connect the OpenRGB SDK server and rescan to detect controllable lighting."/>
                    </StackPanel>
                </Border>
                <ListBox ItemsSource="{Binding Items}" SelectedItem="{Binding Selected}" ItemContainerStyle="{StaticResource PlainItem}">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Text="{Binding Name}" Style="{StaticResource H3}" TextTrimming="CharacterEllipsis"/>
                                    <TextBlock Style="{StaticResource TextDim}" Margin="0,3,0,0">
                                        <Run Text="{Binding Category, Mode=OneWay}"/>
                                        <Run Text="·"/>
                                        <Run Text="{Binding Connection, Mode=OneWay}"/>
                                        <Run Text="·"/>
                                        <Run Text="{Binding Backend, Mode=OneWay}"/>
                                    </TextBlock>
                                    <TextBlock Text="{Binding StatusDetail}" Style="{StaticResource TextMuted}" Margin="0,6,0,0" MaxHeight="36" TextTrimming="CharacterEllipsis"/>
                                </StackPanel>
                                <ContentPresenter Grid.Column="1" Content="{Binding Status}" ContentTemplate="{StaticResource StatusBadge}"
                                                  VerticalAlignment="Top" Margin="12,0,0,0"/>
                            </Grid>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </StackPanel>

            <!-- Detail -->
            <Border Grid.Column="2" Style="{StaticResource Card}" VerticalAlignment="Top"
                    Visibility="{Binding Detail, Converter={StaticResource NullToVis}}">
                <StackPanel DataContext="{Binding Detail}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="{Binding Entry.Name}" Style="{StaticResource H2}" TextWrapping="Wrap"/>
                        <ContentPresenter Grid.Column="1" Content="{Binding Entry.Status}" ContentTemplate="{StaticResource StatusBadge}" Margin="12,2,0,0" VerticalAlignment="Top"/>
                    </Grid>
                    <TextBlock Text="{Binding Entry.StatusDetail}" Style="{StaticResource Body}" Margin="0,10,0,0"/>
                    <Border Margin="0,12,0,0" Background="{StaticResource AccentSoft}" BorderBrush="{StaticResource AccentLine}" BorderThickness="1" CornerRadius="10" Padding="12,10"
                            Visibility="{Binding Entry.NextStep, Converter={StaticResource NullToVis}}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE946;" Style="{StaticResource Icon}" Foreground="{StaticResource Accent}" Margin="0,0,10,0" VerticalAlignment="Top"/>
                            <StackPanel>
                                <TextBlock Text="{Binding Entry.NextStep}" Style="{StaticResource Body}" FontSize="13" MaxWidth="380"/>
                                <Button Style="{StaticResource LinkButton}" HorizontalAlignment="Left" Margin="0,8,0,0"
                                        Command="{Binding DataContext.OpenHelpCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                        Visibility="{Binding Entry.HelpUrl, Converter={StaticResource NullToVis}}">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="{Binding Entry.HelpLabel}" FontSize="13"/>
                                        <TextBlock Text="&#xE8A7;" Style="{StaticResource Icon}" FontSize="11" Margin="6,0,0,0"/>
                                    </StackPanel>
                                </Button>
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <StackPanel Orientation="Horizontal" Margin="0,14,0,0">
                        <Button Content="Identify (blink)" Margin="0,0,8,0"
                                Command="{Binding DataContext.IdentifyCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                Visibility="{Binding CanIdentify, Converter={StaticResource BoolToVis}}"/>
                        <Button Content="Forget device" Style="{StaticResource DangerButton}"
                                Command="{Binding DataContext.ForgetCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                Visibility="{Binding IsOffline, Converter={StaticResource BoolToVis}}"/>
                    </StackPanel>

                    <Rectangle Style="{StaticResource Divider}" Margin="0,18,0,14"/>
                    <ItemsControl ItemsSource="{Binding Properties}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="0,0,0,8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="118"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="{Binding Key}" Style="{StaticResource TextDim}"/>
                                    <TextBlock Grid.Column="1" Text="{Binding Value}" Style="{StaticResource Body}" FontSize="12.5" LineHeight="18"/>
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <StackPanel Visibility="{Binding HasZones, Converter={StaticResource BoolToVis}}">
                        <TextBlock Text="ZONES" Style="{StaticResource Caption}" Margin="0,14,0,10"/>
                        <ItemsControl ItemsSource="{Binding Zones}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Style="{StaticResource SubCard}" Padding="12" Margin="0,0,0,8">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <StackPanel VerticalAlignment="Center">
                                                <TextBlock Text="{Binding Name}" FontWeight="SemiBold" FontSize="13"/>
                                                <TextBlock Text="{Binding Summary}" Style="{StaticResource TextDim}" Margin="0,2,0,0"/>
                                                <TextBlock Text="Set how many LEDs are connected to light this header." Style="{StaticResource TextMuted}"
                                                           Foreground="{StaticResource Blue}" Margin="0,4,0,0"
                                                           Visibility="{Binding NeedsSetup, Converter={StaticResource BoolToVis}}"/>
                                            </StackPanel>
                                            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center"
                                                        Visibility="{Binding IsResizable, Converter={StaticResource BoolToVis}}">
                                                <TextBox Width="64" Text="{Binding LedCountText, UpdateSourceTrigger=PropertyChanged}" TextAlignment="Center" Padding="2,0"
                                                         ToolTip="{Binding Range}"/>
                                                <Button Content="Set" Margin="6,0,0,0" Command="{Binding ApplyCommand}"/>
                                            </StackPanel>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>

                    <StackPanel Visibility="{Binding HasModes, Converter={StaticResource BoolToVis}}">
                        <TextBlock Text="HARDWARE MODES" Style="{StaticResource Caption}" Margin="0,12,0,10"/>
                        <ItemsControl ItemsSource="{Binding Modes}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <WrapPanel/>
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Background="{StaticResource Bg2}" BorderBrush="{StaticResource Line2}" BorderThickness="1" CornerRadius="7" Padding="9,3" Margin="0,0,6,6">
                                        <TextBlock Text="{Binding}" FontSize="12" Foreground="{StaticResource Muted}"/>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>

                    <StackPanel Visibility="{Binding HasHardwareIds, Converter={StaticResource BoolToVis}}">
                        <TextBlock Text="HARDWARE IDS" Style="{StaticResource Caption}" Margin="0,12,0,8"/>
                        <ItemsControl ItemsSource="{Binding HardwareIds}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <TextBox Text="{Binding Mode=OneWay}" IsReadOnly="True" FontFamily="{StaticResource MonoFont}" FontSize="11.5"
                                             Height="28" Margin="0,0,0,4" Background="Transparent" BorderThickness="0" Padding="0"/>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </StackPanel>
            </Border>
        </Grid>
    </StackPanel>
</UserControl>
