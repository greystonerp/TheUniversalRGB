<Window x:Class="UniversalRGB.Desktop.Views.DialogWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent" ResizeMode="NoResize"
        SizeToContent="Height" Width="560" WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        FontFamily="{StaticResource UiFont}" Foreground="{StaticResource Text}" UseLayoutRounding="True"
        TextOptions.TextFormattingMode="Display">
    <Border Margin="18" Background="{StaticResource Panel}" BorderBrush="{StaticResource Line2}" BorderThickness="1"
            CornerRadius="16" Padding="26,24" MouseLeftButtonDown="OnDrag">
        <Border.Effect>
            <DropShadowEffect BlurRadius="28" ShadowDepth="0" Opacity="0.65"/>
        </Border.Effect>
        <StackPanel>
            <StackPanel Orientation="Horizontal">
                <Border x:Name="IconBadge" Width="34" Height="34" CornerRadius="10" Background="{StaticResource AccentSoft}"
                        BorderBrush="{StaticResource AccentLine}" BorderThickness="1" Margin="0,0,12,0">
                    <TextBlock x:Name="IconGlyph" Text="&#xE946;" Style="{StaticResource Icon}" Foreground="{StaticResource Accent}"
                               HorizontalAlignment="Center"/>
                </Border>
                <TextBlock x:Name="TitleText" Style="{StaticResource H2}" VerticalAlignment="Center" TextWrapping="Wrap" MaxWidth="420"/>
            </StackPanel>
            <TextBlock x:Name="MessageText" Style="{StaticResource Body}" Margin="0,14,0,0"/>
            <TextBox x:Name="InputBox" Margin="0,14,0,0" Visibility="Collapsed"/>

            <ItemsControl x:Name="DetailRows" Margin="0,16,0,0" Visibility="Collapsed">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Grid Margin="0,0,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="120"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="{Binding Key}" Style="{StaticResource TextDim}"/>
                            <TextBlock Grid.Column="1" Text="{Binding Value}" Style="{StaticResource Body}" FontSize="12.5" LineHeight="18"/>
                        </Grid>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <ItemsControl x:Name="BlockerList" Visibility="Collapsed" Margin="0,8,0,0">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Background="{StaticResource RedSoft}" BorderBrush="#40F87171" BorderThickness="1" CornerRadius="10" Padding="12,9" Margin="0,0,0,6">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE783;" Style="{StaticResource Icon}" Foreground="{StaticResource Red}" Margin="0,0,10,0" VerticalAlignment="Top"/>
                                <TextBlock Text="{Binding}" Style="{StaticResource Body}" FontSize="12.5" MaxWidth="430"/>
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <ItemsControl x:Name="NoticeList" Visibility="Collapsed" Margin="0,4,0,0">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Background="{StaticResource AmberSoft}" BorderBrush="#40FBBF24" BorderThickness="1" CornerRadius="10" Padding="12,9" Margin="0,0,0,6">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE7BA;" Style="{StaticResource Icon}" Foreground="{StaticResource Amber}" Margin="0,0,10,0" VerticalAlignment="Top"/>
                                <TextBlock Text="{Binding}" Style="{StaticResource Body}" FontSize="12.5" MaxWidth="430"/>
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,22,0,0">
                <Button x:Name="CancelButton" Content="Cancel" Style="{StaticResource GhostButton}" IsCancel="True" Click="OnCancel" MinWidth="90"/>
                <Button x:Name="ConfirmButton" Content="OK" Style="{StaticResource PrimaryButton}" Margin="8,0,0,0" IsDefault="True" Click="OnConfirm" MinWidth="100"/>
            </StackPanel>
        </StackPanel>
    </Border>
</Window>
